@startuml
title sd ModificaStrumenti

start
:selezionaStrumento;
:controllaEsistenza;
if (strumento esistente?) then (si)
    :inserireModifica;
    if (caratteristica == tipo) then (si)
        :controlloEsistenzaTipo;
        if (tipo esistente?) then (si)
            :aggiornaTipo;
            :mostraConfermaModifica;
        else (no)
            :mostraErroreTipo;
        endif
    else (no)
        :modificaCaratteristica;
        :mostraConfermaModifica;
    endif
else (no)
    :mostraErrore;
endif   
end
@enduml